# --- Neon (Postgres + Object Storage) ---
# Do not fill by hand: `neon deploy` / `neon env pull` write these into .env for the linked branch.
# DATABASE_URL           pooled connection, used by the app (Prisma)
# DATABASE_URL_UNPOOLED  direct connection, used by `prisma migrate` (directUrl)
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL_S3 / AWS_REGION  bucket "uploads"
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# --- Auth.js ---
# generate with: npx auth secret
AUTH_SECRET=""
# optional Google OAuth (leave empty to hide the button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Gemini ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# text-to-speech model used for listening / pronunciation reference audio
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# recurring monthly price for Pro
STRIPE_PRO_PRICE_ID="price_..."

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Free daily allowance in seconds (default 600 = 10 min). Lower it to test the limit.
# FREE_DAILY_SECONDS=600

# Required to call /api/health in production (Authorization: Bearer <token>)
# HEALTHCHECK_TOKEN=
